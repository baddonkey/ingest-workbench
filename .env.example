# Local development ONLY. Change before starting on any shared machine.
KC_BOOTSTRAP_ADMIN_USERNAME=local-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=local-admin-change-me

# Optional PostgreSQL persistence foundation, local development ONLY.
POSTGRES_DEV_PASSWORD=postgres-local-only

# Independent archivist review before candidate creation (true or false).
# False creates operator-authorized candidates, never archival acceptance.
AIP_REQUIRE_INDEPENDENT_REVIEW=false

# External advisory KOST service. Native Python uses http://localhost:8001 instead.
KOSTVAL_ENABLED=false
KOSTVAL_URL=http://host.containers.internal:8001
KOSTVAL_API_KEY=
KOSTVAL_LANGUAGE=de
KOSTVAL_POLL_SECONDS=5
KOSTVAL_DEADLINE_SECONDS=3600
# Use another port when the optional PostgreSQL API and KOST both run locally.
POSTGRES_API_PORT=8002
