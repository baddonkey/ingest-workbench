{
  "$defs": {
    "Approval": {
      "additionalProperties": false,
      "properties": {
        "profile_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Profile Sha256",
          "type": "string"
        },
        "approver": {
          "title": "Approver",
          "type": "string"
        },
        "author": {
          "title": "Author",
          "type": "string"
        },
        "context_author": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Context Author"
        },
        "plan_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Sha256",
          "type": "string"
        },
        "context_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Context Sha256",
          "type": "string"
        },
        "target_contexts": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Target Contexts",
          "type": "object"
        },
        "target_resources": {
          "additionalProperties": {
            "additionalProperties": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "type": "object"
          },
          "title": "Target Resources",
          "type": "object"
        },
        "time": {
          "title": "Time",
          "type": "string"
        }
      },
      "required": [
        "profile_sha256",
        "approver",
        "author",
        "context_author",
        "plan_sha256",
        "context_sha256",
        "target_contexts",
        "target_resources",
        "time"
      ],
      "title": "Approval",
      "type": "object"
    },
    "Previous": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "version_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Version Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "version",
        "version_id",
        "sha256"
      ],
      "title": "Previous",
      "type": "object"
    },
    "Resource": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "original_name": {
          "title": "Original Name",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "original_name",
        "media_type",
        "sha256",
        "size",
        "path"
      ],
      "title": "Resource",
      "type": "object"
    },
    "SourceRecord": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "profile": {
          "enum": [
            "1.0",
            "1.1",
            "1.2.0",
            "1.3.0"
          ],
          "title": "Profile",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "minimum": 1,
          "title": "Size",
          "type": "integer"
        },
        "original_metadata_path": {
          "title": "Original Metadata Path",
          "type": "string"
        },
        "metadata_path": {
          "title": "Metadata Path",
          "type": "string"
        },
        "metadata_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Metadata Sha256",
          "type": "string"
        },
        "unit_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Unit Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "profile",
        "sha256",
        "size",
        "original_metadata_path",
        "metadata_path",
        "metadata_sha256",
        "unit_ids"
      ],
      "title": "SourceRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "profile_id": {
      "const": "urn:ch-archive:aip-profile:3.0.0",
      "title": "Profile Id",
      "type": "string"
    },
    "profile_version": {
      "const": "3.0.0",
      "title": "Profile Version",
      "type": "string"
    },
    "profile_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Profile Sha256",
      "type": "string"
    },
    "status": {
      "const": "CANDIDATE",
      "title": "Status",
      "type": "string"
    },
    "archive_scope": {
      "title": "Archive Scope",
      "type": "string"
    },
    "aip_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Aip Id",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "version_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Version Id",
      "type": "string"
    },
    "representation_id": {
      "title": "Representation Id",
      "type": "string"
    },
    "previous_version": {
      "anyOf": [
        {
          "$ref": "#/$defs/Previous"
        },
        {
          "type": "null"
        }
      ]
    },
    "label": {
      "title": "Label",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceRecord"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "resources": {
      "items": {
        "$ref": "#/$defs/Resource"
      },
      "title": "Resources",
      "type": "array"
    },
    "plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "context_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Context Sha256",
      "type": "string"
    },
    "approval": {
      "$ref": "#/$defs/Approval"
    }
  },
  "required": [
    "profile_id",
    "profile_version",
    "profile_sha256",
    "status",
    "archive_scope",
    "aip_id",
    "version",
    "version_id",
    "representation_id",
    "previous_version",
    "label",
    "created_at",
    "sources",
    "resources",
    "plan_sha256",
    "context_sha256",
    "approval"
  ],
  "title": "PreparationDescriptor",
  "type": "object"
}
